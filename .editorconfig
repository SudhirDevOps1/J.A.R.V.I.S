# EditorConfig — https://editorconfig.org
#
# This project has no enforced formatter, so this is the only place a shared
# style is written down. Match the file you are editing.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4

[*.{json,yml,yaml,toml,cfg,ini}]
indent_size = 2

[*.md]
# Markdown uses trailing double-space for a hard line break; trimming it would
# silently change the rendering.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab